/* RESET */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

/* WARNA */

:root{

    --bg:#0d1117;
    --card:#161b22;
    --border:#30363d;

    --text:#e6edf3;
    --muted:#8b949e;

    --blue:#58a6ff;
    --green:#2ea043;

}

/* BODY */

body{

    background:var(--bg);

    color:var(--text);

    font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif;

    line-height:1.7;

}

/* CONTAINER */

.container{

    width:90%;

    max-width:1200px;

    margin:auto;

}

/* ===========================
   HEADER
=========================== */

header{

    position:sticky;

    top:0;

    z-index:1000;

    background:rgba(13,17,23,.95);

    backdrop-filter:blur(10px);

    border-bottom:1px solid var(--border);

}

/* FLEX */

header .container{

    display:flex;

    justify-content:space-between;

    align-items:center;

    min-height:80px;

}

/* LOGO */

.logo{

    display:flex;

    align-items:center;

    gap:15px;

}

.logo img{

    width:60px;

    height:60px;

    object-fit:contain;

}

.logo h1{

    font-size:28px;

    color:var(--blue);

}

.logo p{

    color:var(--muted);

    font-size:13px;

}

/* MENU */

nav ul{

    display:flex;

    gap:25px;

    list-style:none;

}

nav a{

    color:var(--text);

    text-decoration:none;

    transition:.3s;

    font-weight:500;

}

nav a:hover{

    color:var(--blue);

}

/* ===========================
   HERO
=========================== */

.hero{

    padding:120px 0;

    text-align:center;

}

.hero h2{

    font-size:52px;

    margin-bottom:25px;

}

.hero p{

    max-width:700px;

    margin:auto;

    color:var(--muted);

    font-size:18px;

}

/* BUTTON */

.hero-buttons{

    margin-top:40px;

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}

.button{

    display:inline-block;

    padding:15px 35px;

    border-radius:10px;

    text-decoration:none;

    background:var(--green);

    color:white;

    transition:.3s;

}

.button:hover{

    transform:translateY(-3px);

}

.secondary{

    background:var(--blue);

}

/* ===========================
   ARTIKEL
=========================== */

.latest{

    padding:80px 0;

}

.latest h2{

    text-align:center;

    margin-bottom:50px;

    font-size:36px;

}

.cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));

    gap:25px;

}

.card{

    background:var(--card);

    border:1px solid var(--border);

    border-radius:15px;

    padding:25px;

    transition:.3s;

}

.card:hover{

    transform:translateY(-8px);

    border-color:var(--blue);

    box-shadow:0 10px 30px rgba(0,0,0,.4);

}

.category{

    display:inline-block;

    padding:5px 12px;

    border-radius:20px;

    background:var(--blue);

    color:white;

    font-size:12px;

    margin-bottom:15px;

}

.card h3{

    margin-bottom:15px;

}

.card p{

    color:var(--muted);

}

/* ===========================
   FOOTER
=========================== */

footer{

    border-top:1px solid var(--border);

    margin-top:80px;

    padding:50px 0;

    text-align:center;

}

footer h3{

    color:var(--blue);

    margin-bottom:10px;

}

footer p{

    color:var(--muted);

    margin:8px 0;

}

/* ===========================
   RESPONSIVE
=========================== */

@media(max-width:900px){

header .container{

    flex-direction:column;

    padding:20px 0;

}

nav ul{

    margin-top:20px;

    flex-wrap:wrap;

    justify-content:center;

}

.hero h2{

    font-size:36px;

}

}
